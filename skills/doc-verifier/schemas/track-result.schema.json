{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-verifier/track-result.schema.json",
  "title": "doc-verifier Fleet Batch track result",
  "description": "Schema-valid JSON completion envelope returned for one Fleet Batch track attempt.",
  "type": "object",
  "required": [
    "schema_version",
    "taxonomy_version",
    "run_id",
    "track_id",
    "attempt",
    "status",
    "expected_articles",
    "expected_claims",
    "completed_articles",
    "failed_articles",
    "completed_claims",
    "failed_claims",
    "findings",
    "failure",
    "output_bytes",
    "telemetry"
  ],
  "properties": {
    "schema_version": { "const": "1.3.0" },
    "taxonomy_version": { "const": "1.3.0" },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}$" },
    "track_id": { "type": "string", "pattern": "^track-[a-z0-9-]+$" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
    "status": { "enum": ["completed", "failed"] },
    "expected_articles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_claims": {
      "type": "array",
      "items": { "$ref": "claims.schema.json#/$defs/claim_ref" }
    },
    "completed_articles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "failed_articles": {
      "type": "array",
      "items": { "$ref": "#/$defs/failed_article" }
    },
    "completed_claims": {
      "type": "array",
      "items": { "$ref": "claims.schema.json#/$defs/claim_ref" }
    },
    "failed_claims": {
      "type": "array",
      "items": { "$ref": "findings.schema.json#/$defs/failed_claim" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "findings.schema.json#/$defs/finding" }
    },
    "failure": {
      "oneOf": [
        { "$ref": "findings.schema.json#/$defs/failure" },
        { "type": "null" }
      ]
    },
    "output_bytes": { "type": "integer", "minimum": 0 },
    "telemetry": { "$ref": "#/$defs/telemetry" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "failure": { "$ref": "findings.schema.json#/$defs/failure" }
        }
      },
      "else": {
        "properties": { "failure": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "completed" },
          "attempt": { "const": 1 }
        },
        "required": ["status", "attempt"]
      },
      "then": {
        "properties": { "output_bytes": { "maximum": 12288 } }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "completed" },
          "attempt": { "const": 2 }
        },
        "required": ["status", "attempt"]
      },
      "then": {
        "properties": { "output_bytes": { "maximum": 8192 } }
      }
    }
  ],
  "$defs": {
    "failed_article": {
      "type": "object",
      "required": ["path", "reason_code", "message"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reason_code": { "$ref": "findings.schema.json#/$defs/failure_reason" },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "required": [
        "track_weight",
        "elapsed_ms",
        "model",
        "input_tokens",
        "output_tokens",
        "search_calls",
        "fetch_calls",
        "code_sample_calls",
        "cache_hits",
        "field_sources",
        "unavailable_fields"
      ],
      "properties": {
        "track_weight": { "enum": ["light", "medium", "heavy"] },
        "elapsed_ms": { "type": ["integer", "null"], "minimum": 0 },
        "model": { "type": ["string", "null"] },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "search_calls": { "type": ["integer", "null"], "minimum": 0 },
        "fetch_calls": { "type": ["integer", "null"], "minimum": 0 },
        "code_sample_calls": { "type": ["integer", "null"], "minimum": 0 },
        "cache_hits": { "type": ["integer", "null"], "minimum": 0 },
        "field_sources": {
          "type": "object",
          "additionalProperties": { "enum": ["runtime", "orchestrator", "subagent"] }
        },
        "unavailable_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
